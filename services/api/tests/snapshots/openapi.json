{
  "components": {
    "schemas": {
      "ErrorCode": {
        "description": "Stable, machine-readable failure categories for public contracts.",
        "enum": [
          "invalid_arguments",
          "unauthorized",
          "not_found",
          "timeout",
          "dependency_unavailable",
          "rate_limited",
          "internal_error",
          "refused"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Request Id",
            "type": "string"
          },
          "retryable": {
            "default": false,
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorEnvelope": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "SessionIdentityResponse": {
        "additionalProperties": false,
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "title": "Scopes",
            "type": "array"
          },
          "tenant_id": {
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": [
          "tenant_id",
          "scopes",
          "expires_at"
        ],
        "title": "SessionIdentityResponse",
        "type": "object"
      },
      "SessionResponse": {
        "additionalProperties": false,
        "properties": {
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "title": "Scopes",
            "type": "array"
          },
          "tenant_id": {
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": [
          "tenant_id",
          "scopes",
          "csrf_token",
          "expires_at"
        ],
        "title": "SessionResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "SessionCookie": {
        "description": "Opaque Aegon browser session.",
        "in": "cookie",
        "name": "__Host-aegon_session",
        "type": "apiKey"
      },
      "TenantKey": {
        "description": "Tenant exchange credential formatted as `AegonKey <key>`.",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  },
